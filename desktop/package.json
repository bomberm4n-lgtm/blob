{
  "name": "blob",
  "productName": "Blob",
  "version": "0.2.0",
  "description": "Blob - voice, chat and screen sharing with friends",
  "main": "main.js",
  "author": "Blob",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "app.blob.desktop",
    "productName": "Blob",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "connect.html",
      "icon.png",
      "icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Blob-Setup.exe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "maintainer": "Blob",
      "synopsis": "Voice, chat and screen sharing"
    },
    "appImage": {
      "artifactName": "Blob-linux.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bomberm4n-lgtm",
        "repo": "blob",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/bomberm4n-lgtm/blob",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": "https://github.com/bomberm4n-lgtm/blob"
}
